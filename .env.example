# Supabase (Públicas para el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://vjnlijeeptpvhnqeckxw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Supabase (Privada del Servidor - NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Modo de Funcionamiento (true = usa datos y RAG simulados en memoria/PostgreSQL local si no hay claves remotas)
NEXT_PUBLIC_DEMO_MODE=true

# Proveedor de LLM y Embeddings (Servidor)
# Opciones soportadas: gemini | openai | local
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_gemini_api_key_aqui
# OPENAI_API_KEY=tu_openai_api_key_aqui

# Google Drive API (Servidor - Solo lectura)
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu_service_account@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave_privada\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=tu_carpeta_de_politicas_en_drive

# Cron Job Secret (Para proteger el endpoint de reporte diario de las 7:00 a. m. CR)
CRON_SECRET=nube_de_fresa_cron_secret_2026

# Configuración Regional
APP_TIMEZONE=America/Costa_Rica
APP_LOCALE=es-CR

